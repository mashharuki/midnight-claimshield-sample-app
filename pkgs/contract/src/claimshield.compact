pragma language_version >= 0.22 && <= 0.22;

import CompactStandardLibrary;

// ClaimShield keeps policy conditions public while future claim payloads remain
// witness-backed. One deployed contract represents exactly one policy.
export enum PolicyState { open, closed }
export enum ClaimStatus { none, submitted, approved, rejected, redeemed }

export ledger policy_state: PolicyState;
export sealed ledger admin_key: Bytes<32>;
export sealed ledger policy_nonce: Bytes<32>;
export sealed ledger policy_label: Bytes<32>;
export sealed ledger policy_category: Bytes<32>;
export sealed ledger start_at: Uint<64>;
export sealed ledger end_at: Uint<64>;
export sealed ledger minimum_amount: Uint<64>;
export sealed ledger maximum_amount: Uint<64>;
export sealed ledger fixed_benefit: Uint<64>;
export ledger submitted_count: Counter;
export ledger approved_count: Counter;
export ledger planned_benefit_total: Field;
export ledger claims: Map<Bytes<32>, ClaimStatus>;
export ledger commitments: Map<Bytes<32>, Bytes<32>>;
export ledger used_receipt_nullifiers: Set<Bytes<32>>;

witness local_secret_key(): Bytes<32>;
witness get_claim_amount(): Uint<64>;
witness get_merchant_digest(): Bytes<32>;
witness get_evidence_digest(): Bytes<32>;
witness get_opaque_receipt_identifier(): Bytes<32>;
witness get_claim_salt(): Bytes<32>;
witness store_claim(
  amount: Uint<64>,
  merchant_digest: Bytes<32>,
  evidence_digest: Bytes<32>,
  opaque_receipt_identifier: Bytes<32>,
  salt: Bytes<32>
): [];

export pure circuit derive_claimant_key(
  nonce: Bytes<32>,
  secret_key: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "claimshield:claimant:v1"), nonce, secret_key
  ]);
}

pure circuit make_payload_commitment(
  nonce: Bytes<32>,
  claimant_key: Bytes<32>,
  amount: Uint<64>,
  merchant_digest: Bytes<32>,
  evidence_digest: Bytes<32>,
  opaque_receipt_identifier: Bytes<32>,
  salt: Bytes<32>
): Bytes<32> {
  const amount_bytes = ((amount as Field) as Bytes<32>);
  return persistentHash<Vector<8, Bytes<32>>>([
    pad(32, "claimshield:payload:v1"),
    nonce,
    claimant_key,
    amount_bytes,
    merchant_digest,
    evidence_digest,
    opaque_receipt_identifier,
    salt
  ]);
}

pure circuit make_receipt_nullifier(
  nonce: Bytes<32>,
  opaque_receipt_identifier: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "claimshield:receipt:v1"),
    nonce,
    opaque_receipt_identifier
  ]);
}

circuit require_admin(): [] {
  const caller_key = derive_claimant_key(policy_nonce, local_secret_key());
  assert(disclose(caller_key == admin_key), "Only the policy administrator can perform this action");
}

// `submit_claim` is implemented in task 2.3. Keeping the policy guard in the
// contract now ensures later submission logic cannot bypass the policy state.
circuit require_policy_open(): [] {
  assert(policy_state == PolicyState.open, "Policy is closed to new claims");
}

circuit require_submitted_claim(claimant_key: Bytes<32>): [] {
  assert(claims.member(claimant_key), "Claim does not exist");
  assert(
    claims.lookup(claimant_key) == ClaimStatus.submitted,
    "Claim has already been decided"
  );
}

constructor(
  label: Bytes<32>,
  category: Bytes<32>,
  policy_start_at: Uint<64>,
  policy_end_at: Uint<64>,
  policy_minimum_amount: Uint<64>,
  policy_maximum_amount: Uint<64>,
  policy_fixed_benefit: Uint<64>,
  nonce: Bytes<32>
) {
  const public_label = disclose(label);
  const public_category = disclose(category);
  const public_start_at = disclose(policy_start_at);
  const public_end_at = disclose(policy_end_at);
  const public_minimum_amount = disclose(policy_minimum_amount);
  const public_maximum_amount = disclose(policy_maximum_amount);
  const public_fixed_benefit = disclose(policy_fixed_benefit);
  const public_nonce = disclose(nonce);

  assert(public_label != default<Bytes<32>>, "Policy label is required");
  assert(public_category != default<Bytes<32>>, "Policy category is required");
  assert(public_start_at < public_end_at, "Policy start time must be before end time");
  assert(public_minimum_amount <= public_maximum_amount, "Policy minimum amount must not exceed maximum amount");
  assert(public_fixed_benefit > 0, "Policy fixed benefit must be positive");

  policy_state = PolicyState.open;
  admin_key = disclose(derive_claimant_key(nonce, local_secret_key()));
  policy_nonce = public_nonce;
  policy_label = public_label;
  policy_category = public_category;
  start_at = public_start_at;
  end_at = public_end_at;
  minimum_amount = public_minimum_amount;
  maximum_amount = public_maximum_amount;
  fixed_benefit = public_fixed_benefit;
  planned_benefit_total = 0;
}

export circuit close_policy(): [] {
  require_admin();
  require_policy_open();
  policy_state = PolicyState.closed;
}

export circuit submit_claim(): [] {
  require_policy_open();

  const claimant_key = derive_claimant_key(policy_nonce, local_secret_key());
  const public_claimant_key = disclose(claimant_key);
  assert(!claims.member(public_claimant_key), "Claimant already submitted");

  const amount = get_claim_amount();
  const meets_minimum = disclose(amount >= minimum_amount);
  const meets_maximum = disclose(amount <= maximum_amount);
  assert(
    meets_minimum && meets_maximum,
    "Claim amount is outside policy range"
  );
  const merchant_digest = get_merchant_digest();
  const evidence_digest = get_evidence_digest();
  const opaque_receipt_identifier = get_opaque_receipt_identifier();
  const salt = get_claim_salt();
  const receipt_nullifier = make_receipt_nullifier(
    policy_nonce,
    opaque_receipt_identifier
  );
  const public_receipt_nullifier = disclose(receipt_nullifier);
  assert(
    !used_receipt_nullifiers.member(public_receipt_nullifier),
    "Receipt has already been used for this policy"
  );
  const commitment = make_payload_commitment(
    policy_nonce,
    claimant_key,
    amount,
    merchant_digest,
    evidence_digest,
    opaque_receipt_identifier,
    salt
  );

  store_claim(
    amount,
    merchant_digest,
    evidence_digest,
    opaque_receipt_identifier,
    salt
  );
  claims.insert(public_claimant_key, ClaimStatus.submitted);
  commitments.insert(public_claimant_key, disclose(commitment));
  used_receipt_nullifiers.insert(public_receipt_nullifier);
  submitted_count.increment(1);
}

export circuit approve_claim(claimant_key: Bytes<32>): [] {
  require_admin();
  const public_claimant_key = disclose(claimant_key);
  require_submitted_claim(public_claimant_key);

  claims.insert(public_claimant_key, ClaimStatus.approved);
  approved_count.increment(1);
  planned_benefit_total = planned_benefit_total + (fixed_benefit as Field);
}

// Rejection reasons are intentionally reviewed and retained outside ClaimShield.
// They never become a circuit argument, private state, or public ledger value.
export circuit reject_claim(claimant_key: Bytes<32>): [] {
  require_admin();
  const public_claimant_key = disclose(claimant_key);
  require_submitted_claim(public_claimant_key);

  claims.insert(public_claimant_key, ClaimStatus.rejected);
}

export circuit redeem_claim(): [] {
  const claimant_key = derive_claimant_key(policy_nonce, local_secret_key());
  const public_claimant_key = disclose(claimant_key);
  assert(claims.member(public_claimant_key), "Claim does not exist");
  assert(
    claims.lookup(public_claimant_key) == ClaimStatus.approved,
    "Claim is not approved for redemption"
  );

  const amount = get_claim_amount();
  const merchant_digest = get_merchant_digest();
  const evidence_digest = get_evidence_digest();
  const opaque_receipt_identifier = get_opaque_receipt_identifier();
  const salt = get_claim_salt();
  const expected_commitment = make_payload_commitment(
    policy_nonce,
    claimant_key,
    amount,
    merchant_digest,
    evidence_digest,
    opaque_receipt_identifier,
    salt
  );
  assert(
    disclose(expected_commitment == commitments.lookup(public_claimant_key)),
    "Claim commitment does not match private payload"
  );

  claims.insert(public_claimant_key, ClaimStatus.redeemed);
}
